# PostgreSQL / PostGIS
POSTGRES_USER=critical1
POSTGRES_PASSWORD=critical1_dev
POSTGRES_DB=critical1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://critical1:critical1_dev@localhost:5433/critical1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SPATIAL_SRID=4326
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_REQUEST_TIMEOUT_SECONDS=60
OSM_ENABLED=true
UPLOAD_DIR=./backend/data/uploads

# Privacy / robustness (Module 4)
MAX_UPLOAD_BYTES=5000000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXPENSIVE_PER_WINDOW=20

# City-agnostic defaults + data lake
DEFAULT_CITY_ID=nagpur
DATA_DIR=./data

# Optional Copernicus CDS (ERA5) — leave unset to use Open-Meteo instead
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=uid:api-key

# Module 2 — optional weight overrides (JSON object of component key → weight)
# SCORING_WEIGHTS_JSON={"flood_hazard_exposure":0.35,"population_exposure":0.1,"road_disruption_risk":0.2,"healthcare_travel_burden":0.25,"infrastructure_availability":0.1}

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
